# /srv/friendsshare/.env on the server (mode 600, never in git).
# PORT, DATA_DIR and TRUST_PROXY are set by deploy/compose.yml.
BASE_URL=https://friendsshare.example.com
# Signs sessions and sign-in state. Changing it signs everybody out.
APP_SECRET=

# Only official releases may use the matchmaking. BUILD_SECRET is the same value as the
# BUILD_SECRET secret of the GitHub repository (the release workflow stamps it into the app).
REQUIRE_OFFICIAL=1
MIN_VERSION=1.2.0
BUILD_SECRET=

# Sign-in. Written by `node deploy/setup-login.js github|google <ssh-host>`.
# Callback URLs: <BASE_URL>/auth/github/callback and <BASE_URL>/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pro subscriptions (Stripe). Written by deploy/stripe-setup.sh. Without them everything is free
# and the folder limit is off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
PRICE_DISPLAY_MONTHLY=€1.99
PRICE_DISPLAY_YEARLY=€11.88
PRICE_DISPLAY_YEARLY_PER_MONTH=€0.99
# Folders at a time on the free plan
FREE_LIMIT=5

# Operator: switches on /imprint, /privacy and /terms (address lines separated by ";")
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_HOSTING=
OPERATOR_EMAIL=
