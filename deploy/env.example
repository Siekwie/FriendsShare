# /srv/friendsshare/.env on the server (mode 600, never in git).
# PORT, DATA_DIR and TRUST_PROXY are set by deploy/compose.yml.
BASE_URL=https://friendsshare.example.com
# Signs sessions and sign-in state. Changing it signs everybody out.
APP_SECRET=

# Only official releases may use the matchmaking. BUILD_SECRET is the same value as the
# BUILD_SECRET secret of the GitHub repository (the release workflow stamps it into the app).
REQUIRE_OFFICIAL=1
MIN_VERSION=1.2.0
BUILD_SECRET=
# In an emergency a build can be admitted by hand: EXTRA_BUILDS=1.2.3:<sha256 of its app.asar>

# Sign-in. Written by `node deploy/setup-login.js github|google <ssh-host>`.
# Callback URLs: <BASE_URL>/auth/github/callback and <BASE_URL>/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pro subscriptions (Stripe). Written by deploy/stripe-setup.sh. The Pro plan and the folder limit
# are on only when these are set AND at least one sign-in method is.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# FriendsShare's own customer portal settings (the Stripe account's default may be another product's)
STRIPE_PORTAL_CONFIG=
PRICE_DISPLAY_MONTHLY=€1.99
PRICE_DISPLAY_YEARLY=€11.88
PRICE_DISPLAY_YEARLY_PER_MONTH=€0.99
# 1: Stripe sells as merchant of record (Managed Payments; switch it on in the Stripe dashboard first)
#STRIPE_MANAGED_PAYMENTS=1
# Folders at a time on the free plan
FREE_LIMIT=5
#
# About the key: with an "agent-tagged" Stripe key, Stripe asks the account owner for approval
# before a subscription is cancelled (Settings > Approvals). The server copes (a deleted account's
# subscription then ends with its paid period), but an ordinary restricted key avoids the detour.

# Protection against flooding, per client address (defaults shown)
#WS_MAX_PER_ADDRESS=40
#WS_UPGRADES_PER_MINUTE=120
#ROOMS_PER_ADDRESS_HOUR=60
#MAX_ROOMS=200000

# Database snapshots in DATA_DIR/backups
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=7

# Operator: switches on /imprint, /privacy and /terms (address lines separated by ";")
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_HOSTING=
OPERATOR_EMAIL=
