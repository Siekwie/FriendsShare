{
  "name": "friendsshare",
  "productName": "FriendsShare",
  "version": "1.2.1",
  "description": "Share big folders with friends, directly from PC to PC",
  "author": "Siekwie",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "test": "npm --prefix server test && node test/run.js",
    "dist": "electron-builder --win portable --publish never",
    "icons": "electron scripts/make-icons.js",
    "og": "electron scripts/make-og.js",
    "screenshots": "electron scripts/screenshots.js --hidden",
    "test:server": "npm --prefix server test",
    "test:app": "node test/run.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "eu.wiest-lab.friendsshare",
    "files": [
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FriendsShare.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
